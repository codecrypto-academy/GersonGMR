# ==========================================
# ESCROW DAPP - ENVIRONMENT VARIABLES
# ==========================================
# Copia este archivo a .env y completa los valores
# NUNCA subas el archivo .env al repositorio

# ==========================================
# BLOCKCHAIN / RPC
# ==========================================
# URL del nodo RPC (Anvil local por defecto)
RPC_URL=http://localhost:8545

# Chain ID de la red
CHAIN_ID=31337

# ==========================================
# PRIVATE KEYS (SOLO PARA DESARROLLO)
# ==========================================
# ⚠️ ADVERTENCIA: Nunca uses estas claves en mainnet
# ⚠️ Nunca subas claves privadas reales a un repositorio
# Estas son las claves de prueba de Anvil (públicas)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ==========================================
# CONTRACT ADDRESSES
# ==========================================
# Estas direcciones se actualizan automáticamente con deploy.sh
# También puedes configurarlas manualmente aquí
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_A_ADDRESS=
NEXT_PUBLIC_TOKEN_B_ADDRESS=

# ==========================================
# API KEYS (para producción)
# ==========================================
# Etherscan API key para verificación de contratos
ETHERSCAN_API_KEY=

# Alchemy/Infura API key para RPC en producción
ALCHEMY_API_KEY=
INFURA_API_KEY=

# ==========================================
# OPCIONALES
# ==========================================
# Gas price en gwei (opcional)
GAS_PRICE=

# Gas limit (opcional)
GAS_LIMIT=
