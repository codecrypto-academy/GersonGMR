# Blockchain
NEXT_PUBLIC_EUROTOKEN_CONTRACT_ADDRESS=
NEXT_PUBLIC_RPC_URL=http://localhost:8545
PRIVATE_KEY=

# Opcional. Base URL de esta app. Si el webhook no puede llamar a /api/mint-tokens, ponla (ej. local: http://localhost:6001).
NEXT_PUBLIC_APP_URL=

# Solo para uso interno webhook → mint. Genera un valor aleatorio largo y no lo expongas.
MINT_INTERNAL_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Webhook signing secret (not an API key). Local: run `stripe listen --forward-to localhost:6001/api/webhook` and use the whsec_... it prints. Production: Stripe Dashboard → Webhooks → [endpoint] → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_
